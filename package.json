{
  "name": "bb-plugin-workspace-files",
  "version": "0.2.1",
  "description": "Conductor-style files panel for the workspace behind a thread: a file tree with search in files, a Changes tab with Viewed and discard, BB's diff renderer, and a Monaco editor with autosave.",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.141"
  },
  "bb": {
    "name": "Workspace Files",
    "description": "Conductor-style files panel for the workspace behind a thread: a file tree with search in files, a Changes tab with Viewed and discard, BB's diff renderer, and a Monaco editor with autosave.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "monaco-editor": "^0.57.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.141",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "homepage": "https://github.com/promontis/bb-plugin-workspace-files#readme",
  "bugs": {
    "url": "https://github.com/promontis/bb-plugin-workspace-files/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promontis/bb-plugin-workspace-files.git"
  },
  "keywords": [
    "bb-plugin",
    "files",
    "file-explorer",
    "grep",
    "full-text-search",
    "search-in-files",
    "file-browser",
    "file-tree",
    "editor",
    "code-editor",
    "text-editor",
    "syntax-highlighting",
    "find-in-file",
    "vscode",
    "workspace"
  ],
  "files": [
